# Application
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Database and queue
DATABASE_URL=postgres://orbitt:orbitt@localhost:5432/orbitt
REDIS_URL=redis://localhost:6379

# Secrets must be generated for each installation. Never commit real values.
APP_ENCRYPTION_KEY=
SESSION_SECRET=

# Optional RPC endpoints; configure only the networks you enable.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
BNB_RPC_URL=
SOLANA_RPC_URL=
TRON_RPC_URL=
BITCOIN_RPC_URL=
LITECOIN_RPC_URL=

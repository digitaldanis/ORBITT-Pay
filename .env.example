# Application
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CHECKOUT_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=
HOST=0.0.0.0
TRUST_PROXY=false
INVOICE_EXPIRY_MINUTES=15
# Optional asset/rate config overrides (paths are resolved from the working directory).
ORBITT_ASSETS_FILE=
ORBITT_RATE_ASSETS_FILE=

# Database
DATABASE_URL=postgres://orbitt:orbitt@localhost:5432/orbitt
POSTGRES_USER=orbitt
POSTGRES_PASSWORD=
POSTGRES_DB=orbitt
CHECKOUT_PORT=8080
DASHBOARD_PORT=8081

# Secrets must be generated for each installation. Never commit real values.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
DASHBOARD_USER_PASSWORD=

# Optional RPC endpoints; configure only the networks you enable.
ETHEREUM_RPC_URL=
SEPOLIA_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
BNB_RPC_URL=
SOLANA_RPC_URL=
TRON_RPC_URL=
BITCOIN_RPC_URL=
BITCOIN_TESTNET_EXPLORER_URL=
LITECOIN_RPC_URL=
# Optional per-network scanner confirmation overrides (integer block confirmations).
# CONFIRMATIONS_BITCOIN=2
# CONFIRMATIONS_ETHEREUM=12

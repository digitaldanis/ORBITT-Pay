# Application
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CHECKOUT_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=
HOST=0.0.0.0
TRUST_PROXY=false
# How long a locked quote stays valid once the customer picked a coin.
INVOICE_EXPIRY_MINUTES=15
# How long a payment link waits for the customer to pick a coin.
CHECKOUT_SELECTION_MINUTES=60
# Only offer networks whose scanner reported in the last minutes (set false for local demos).
CHECKOUT_REQUIRE_LIVE_SCANNER=true
# Optional asset/rate config overrides (paths are resolved from the working directory).
ORBITT_ASSETS_FILE=
ORBITT_RATE_ASSETS_FILE=

# Database
DATABASE_URL=postgres://orbitt:orbitt@localhost:5432/orbitt
POSTGRES_USER=orbitt
POSTGRES_PASSWORD=
POSTGRES_DB=orbitt
CHECKOUT_PORT=8080
DASHBOARD_PORT=8081

# Secrets must be generated for each installation. Never commit real values.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
DASHBOARD_USER_PASSWORD=

# Chain endpoints. Configure only the networks you enable; comma-separate several URLs for failover.
# Bitcoin and Litecoin use an Esplora API (mempool.space compatible).
BITCOIN_ESPLORA_URL=https://mempool.space/api
BITCOIN_TESTNET_ESPLORA_URL=
LITECOIN_ESPLORA_URL=https://litecoinspace.org/api
# EVM networks use JSON-RPC.
ETHEREUM_RPC_URL=
SEPOLIA_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
BNB_RPC_URL=
# TRON uses the TronGrid v1 API; a key raises the rate limit.
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=
# Solana JSON-RPC with getSignaturesForAddress support.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional per-network confirmation overrides (integer confirmations).
# CONFIRMATIONS_BITCOIN=2
# CONFIRMATIONS_ETHEREUM=12
# CONFIRMATIONS_TRON=1

# Development only: allow webhook targets on localhost / private networks.
# Ignored when NODE_ENV=production.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

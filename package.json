{
  "name": "orbitt-pay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, non-custodial crypto payment processing for online shops.",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build --workspace apps/checkout && npm run build --workspace apps/dashboard",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "^9.39.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  }
}
